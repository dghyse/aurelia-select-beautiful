{
  "name": "@fractalcms/aurelia-select-beautiful",
  "version": "1.0.1",
  "description": "Custom Select component for Aurelia 2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/styles/select-beautiful.css": "./dist/styles/select-beautiful.css",
    "./styles.css": "./dist/styles/select-beautiful.css"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build:ts": "tsc",
    "build:scss": "sass src/styles/select-beautiful.scss dist/styles/select-beautiful.css --no-source-map --style=compressed",
    "build": "npm run build:ts && npm run build:scss",
    "watch:ts": "tsc --watch",
    "watch:scss": "sass --watch src/styles/select-beautiful.scss:dist/styles/select-beautiful.css --no-source-map",
    "watch": "npm run watch:ts && npm run watch:scss",
    "prepare": "npm run build"
  },
  "sideEffects": [
    "./dist/styles/select-beautiful.css"
  ],
  "keywords": [
    "aurelia",
    "select",
    "component",
    "accessible",
    "multiselect",
    "ui",
    "fractalcms",
    "fractal-cms",
    "fractalCms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dghyse/aurelia-select-beautiful.git"
  },
  "bugs": {
    "url": "https://github.com/dghyse/aurelia-select-beautiful/issues"
  },
  "author": "David Ghyse",
  "license": "MIT",
  "homepage": "https://github.com/dghyse/aurelia-select-beautiful#readme",
  "peerDependencies": {
    "aurelia": "^2.0.0-beta.25"
  },
  "devDependencies": {
    "aurelia": "^2.0.0-beta.25",
    "sass": "^1.93.3",
    "typescript": "^5.9.3"
  }
}
